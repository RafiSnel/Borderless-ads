  {"id": "g2", "who": "gema", "text": "\"Your streak misses you.\"", "gap": 0.4},
  {"id": "r2", "who": "racha", "text": "Weak.", "gap": 0.3},
  {"id": "f2", "who": "ficha", "text": "\"We noticed you're gone. Again.\"", "gap": 0.4},
