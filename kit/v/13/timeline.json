   12.676,
   13.436,
   13.756
  ]
 },
 {
  "n": 5,
  "text": "But really? Mate.",
  "start": 14.194,
  "end": 15.682,
  "phrases": [
   14.214,
   14.454,
   15.174,
   15.614
  ]
 },
 {
  "n": 6,
  "text": "Guay. Cool. Say it like... g-why.",
  "start": 16.482,
  "end": 19.539,
  "phrases": [
   16.482,
   17.242,
   17.962,
   18.962
  ]
 },
 {
