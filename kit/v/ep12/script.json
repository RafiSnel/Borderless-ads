  {"id": "d3", "who": "directie", "text": "Nobody likes you without badges.", "gap": 0.8, "fx": "echo", "gain": 1.4},
  {"id": "g1", "who": "gema", "text": "I have friends. Real ones. They don't even have badges.", "gap": 0.4},
  {"id": "d4", "who": "directie", "text": "You can't even make a sentence.", "gap": 0.8, "fx": "echo", "gain": 1.4},
  {"id": "f1", "who": "ficha", "text": "Puedo hablar. Mal… pero puedo.", "sub": "I can speak. Badly… but I can.", "gap": 0.4},
