  {"id": "d5", "who": "directie", "text": "No— no— look at me— LOOK AT ME—", "after": "p2", "gap": 4.6, "gain": 1.2},
  {"id": "f2", "who": "ficha", "text": "El gato… de la casa.", "sub": "The house cat.", "gap": 1.8},
  {"id": "r2", "who": "racha", "text": "Carmen: ¡cañas para todos! ¡Invito yo!", "sub": "Carmen: beers for everyone! My treat!", "gap": 4.2},
  {"id": "p3", "who": "hero", "text": "…Vale.", "sub": "…Okay.", "gap": 1.4},
